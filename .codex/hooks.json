{
  "description": "Format the repository and require a successful integrity build before Codex completes a turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && sh .codex/hooks/verify-project-integrity.sh",
            "statusMessage": "Verifying Memly project integrity"
          }
        ]
      }
    ]
  }
}
