Checks: |
  -*,
  abseil-*,
  android-*,
  boost-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  cert-*,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-use-default-member-init,
  darwin-*,
  hicpp-*,
  -hicpp-deprecated-headers,
  -hicpp-explicit-conversions,
  -hicpp-function-size,
  -hicpp-named-parameter,
  -hicpp-use-auto,
  misc-*,
  modernize-*,
  -modernize-deprecated-headers,
  -modernize-macro-to-enum,
  -modernize-use-default-member-init,
  -modernize-use-auto,
  -modernize-use-using,
  mpi-*,
  objc-*,
  openmp-*,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-function-size,
  -readability-identifier-naming,
  -readability-named-parameter,
  -readability-redundant-casting,
  -readability-redundant-declaration,
  -readability-redundant-member-init,
  -readability-redundant-typename,
  -readability-use-concise-preprocessor-directives,
  custom-memly-always-explicit-constructor,
  custom-memly-braced-constructor-initializer,
  custom-memly-braced-variable-initialization,
  custom-memly-complete-constructor-initializer-list,
  custom-memly-data-struct-constructor-noexcept,
  custom-memly-defaulted-or-deleted-copy-move-operation,
  custom-memly-defaulted-or-deleted-destructor-definition,
  custom-memly-interface-required-constructor-definition-in-class,
  custom-memly-runtime-constructor-definition-in-implementation-file,
  custom-memly-conversion-operator,
  custom-memly-declared-ordinary-constructor,
  custom-memly-enum-type-suffix,
  custom-memly-expected-value-suffix,
  custom-memly-explicit-contextual-braced-default-argument,
  custom-memly-explicit-contextual-braced-expression,
  custom-memly-explicit-memly-exception-throw,
  custom-memly-explicit-rule-of-five,
  custom-memly-explicit-return-type-construction,
  custom-memly-internal-declaration-namespace,
  custom-memly-internal-namespace-reserved,
  custom-memly-no-class-template-argument-deduction,
  custom-memly-no-database-chain-proxy-field,
  custom-memly-no-database-chain-proxy-variable,
  custom-memly-no-default-member-initializer,
  custom-memly-no-delegating-constructor,
  custom-memly-no-deduced-variable-type,
  custom-memly-no-global-prefix,
  custom-memly-no-module-interface-function-definition,
  custom-memly-no-magic-integer-in-assertion,
  custom-memly-no-magic-integer-in-constant-declaration-type,
  custom-memly-no-negative-magic-integer,
  custom-memly-no-zero-floating-point-magic-number,
  custom-memly-no-named-lambda,
  custom-memly-no-named-declaration-parameter,
  custom-memly-no-namespace-variable,
  custom-memly-non-static-data-member-prefix,
  custom-memly-no-type-declaration-in-implementation-file,
  custom-memly-no-typedef,
  custom-memly-no-using-declaration,
  custom-memly-non-owning-range-view-parameter-by-value,
  custom-memly-nodiscard-callable,
  custom-memly-nodiscard-enum,
  custom-memly-nodiscard-returned-record,
  custom-memly-no-direct-field-defaulted-default-constructor,
  custom-memly-no-two-statement-pass-through-variable,
  custom-memly-optional-value-suffix,
  custom-memly-owning-string-parameter-by-reference,
  custom-memly-scalar-parameter-by-value,
  custom-memly-standard-container-value-suffix,
  custom-memly-source-location-parameter-by-value,
  custom-memly-static-variable-prefix,
  custom-memly-string-view-definition-parameter-const,
  custom-memly-string-view-parameter-by-value,
  custom-memly-type-template-parameter-name,
  custom-memly-unnamed-namespace-declaration-prefix,
  custom-memly-unnamed-namespace-nesting,
  custom-memly-unnamed-namespace-prefix-reserved,
  custom-memly-use-std-invoke,
  custom-memly-variant-value-suffix
WarningsAsErrors: "*"
CheckOptions:
  - { key: bugprone-unused-local-non-trivial-variable.IncludeTypes, value: ".*" }
  - { key: cppcoreguidelines-avoid-magic-numbers.IgnoredIntegerValues, value: "1" }
  - { key: cppcoreguidelines-avoid-magic-numbers.IgnoredFloatingPointValues, value: "" }
  - { key: cppcoreguidelines-macro-usage.AllowedRegexp, value: "" }
  - { key: misc-include-cleaner.MissingIncludes, value: "false" }
  - { key: misc-include-cleaner.UnusedIncludes, value: "true" }
  - { key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic, value: "true" }
  - { key: readability-magic-numbers.IgnoredIntegerValues, value: "1" }
  - { key: readability-magic-numbers.IgnoredFloatingPointValues, value: "" }
  - { key: readability-operators-representation.BinaryOperators, value: "and;and_eq;bitand;bitor;compl;not;not_eq;or;or_eq;xor;xor_eq" }
  - { key: readability-operators-representation.OverloadedOperators, value: "and;and_eq;bitand;bitor;compl;not;not_eq;or;or_eq;xor;xor_eq" }
CustomChecks:
  - Name: memly-always-explicit-constructor
    Query: >-
      match cxxConstructorDecl( unless(isImplicit()), unless(isTemplateInstantiation()), unless(isExplicit()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("constructor")
    Diagnostic:
      - BindName: constructor
        Message: constructor must be declared explicit
        Level: Warning
  - Name: memly-braced-constructor-initializer
    Query: >-
      match cxxConstructorDecl( unless(isImplicit()), unless(isDeleted()), unless(isDefaulted()), unless(isDelegatingConstructor()),
      unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()), isExpansionInFileMatching("[/\\\\]source[/\\\\]"), forEachConstructorInitializer(
      cxxCtorInitializer( isWritten(), unless( withInitializer( ignoringImplicit( anyOf( initListExpr(), cxxConstructExpr(isListInitialization()) ) ) ) )
      ).bind("initializer") ) )
    Diagnostic:
      - BindName: initializer
        Message: constructor initializers must use brace initialization
        Level: Warning
  - Name: memly-braced-variable-initialization
    Query: >-
      match varDecl( isDefinition(), unless(parmVarDecl()), unless(isImplicit()), unless(isExceptionVariable()), unless(isExpansionInSystemHeader()), unless(
      hasParent( declStmt( hasParent(cxxForRangeStmt()) ) ) ), unless( hasInitializer( ignoringImplicit( anyOf( initListExpr(),
      cxxConstructExpr(isListInitialization()) ) ) ) ), isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("variable")
    Diagnostic:
      - BindName: variable
        Message: named variable definitions must use brace initialization
        Level: Warning
  - Name: memly-complete-constructor-initializer-list
    Query: >-
      match cxxConstructorDecl( unless(isImplicit()), unless(isDeleted()), unless(isDefaulted()), unless(isDelegatingConstructor()),
      unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()), hasAnyConstructorInitializer( unless(isWritten()) ),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("constructor")
    Diagnostic:
      - BindName: constructor
        Message: constructor must explicitly initialize every direct base and non-static data member
        Level: Warning
  - Name: memly-data-struct-constructor-noexcept
    Query: >-
      match cxxConstructorDecl( unless(isImplicit()), unless(isDeleted()), unless(isTemplateInstantiation()), unless(isNoThrow()),
      unless(isExpansionInSystemHeader()), ofClass( cxxRecordDecl( isStruct(), matchesName("^::Memly::") ) ), isExpansionInFileMatching("[/\\\\]source[/\\\\]")
      ).bind("constructor")
    Diagnostic:
      - BindName: constructor
        Message: data-struct constructors must be declared noexcept
        Level: Warning
  - Name: memly-defaulted-or-deleted-copy-move-operation
    Query: >-
      match cxxMethodDecl( unless(isImplicit()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), anyOf( cxxConstructorDecl( anyOf(isCopyConstructor(), isMoveConstructor()) ),
      isCopyAssignmentOperator(), isMoveAssignmentOperator() ), unless(anyOf(isDefaulted(), isDeleted())) ).bind("special_member")
    Diagnostic:
      - BindName: special_member
        Message: copy and move operations must be explicitly defaulted or deleted
        Level: Warning
  - Name: memly-defaulted-or-deleted-destructor-definition
    Query: >-
      match cxxDestructorDecl( isDefinition(), unless(isImplicit()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), unless(anyOf(isDefaulted(), isDeleted())) ).bind("destructor")
    Diagnostic:
      - BindName: destructor
        Message: destructor definitions must be explicitly defaulted or deleted
        Level: Warning
  - Name: memly-interface-required-constructor-definition-in-class
    Query: >-
      match cxxConstructorDecl( isDefinition(), unless(isImplicit()), unless(isDeleted()), unless(isTemplateInstantiation()),
      unless(isExpansionInSystemHeader()), anyOf( isConstexpr(), hasParent(functionTemplateDecl()), ofClass(cxxRecordDecl(anyOf(
      hasAncestor(classTemplateDecl()), hasAncestor(classTemplatePartialSpecializationDecl()) ))), allOf( isDefaulted(), isDefaultConstructor(),
      ofClass(cxxRecordDecl(unless(has(fieldDecl())))) ) ), unless( anyOf( hasParent(cxxRecordDecl()),
      hasParent(functionTemplateDecl(hasParent(cxxRecordDecl()))) ) ), isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("constructor")
    Diagnostic:
      - BindName: constructor
        Message: eligible defaulted, constexpr, and template-dependent constructor definitions must appear inside their class or struct declaration
        Level: Warning
  - Name: memly-runtime-constructor-definition-in-implementation-file
    Query: >-
      match cxxConstructorDecl( isDefinition(), unless(isImplicit()), unless(isDeleted()), unless(isCopyConstructor()), unless(isMoveConstructor()),
      unless(isDefaulted()), unless(isConstexpr()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()),
      unless(hasParent(functionTemplateDecl())), unless( ofClass( cxxRecordDecl( anyOf( hasAncestor(classTemplateDecl()),
      hasAncestor(classTemplatePartialSpecializationDecl()) ) ) ) ), anyOf( hasParent(cxxRecordDecl()), unless(isExpansionInFileMatching("[.]cpp$")) ),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("constructor")
    Diagnostic:
      - BindName: constructor
        Message: non-template non-constexpr constructor definitions must appear in a .cpp implementation file
        Level: Warning
  - Name: memly-conversion-operator
    Query: >-
      match cxxConversionDecl( unless(isImplicit()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()), ofClass( cxxRecordDecl(
      matchesName("^::Memly::") ) ) ).bind("conversion")
    Diagnostic:
      - BindName: conversion
        Message: conversion operators are disallowed
        Level: Warning
  - Name: memly-declared-ordinary-constructor
    Query: >-
      match cxxRecordDecl( isDefinition(), unless(isImplicit()), unless(isLambda()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()),
      matchesName("^::Memly::"), unless( anyOf( has( cxxConstructorDecl( unless(isImplicit()), unless(isCopyConstructor()), unless(isMoveConstructor()) ) ),
      has( functionTemplateDecl( has( cxxConstructorDecl( unless(isImplicit()), unless(isCopyConstructor()), unless(isMoveConstructor()) ) ) ) ) ) )
      ).bind("record")
    Diagnostic:
      - BindName: record
        Message: Memly types must explicitly declare an ordinary constructor
        Level: Warning
  - Name: memly-enum-type-suffix
    Query: >-
      match enumDecl( unless(isImplicit()), unless( hasAncestor( functionDecl(isTemplateInstantiation()) ) ), unless( hasAncestor(
      cxxRecordDecl(isTemplateInstantiation()) ) ), isExpansionInMainFile(), isExpansionInFileMatching("[/\\\\]source[/\\\\]"), matchesName("^::.+$"),
      unless(matchesName("Enum$")) ).bind("enum")
    Diagnostic:
      - BindName: enum
        Message: enum type names must end in Enum
        Level: Warning
  - Name: memly-expected-value-suffix
    Query: >-
      match declaratorDecl( anyOf( varDecl( unless(parmVarDecl()) ), parmVarDecl( matchesName("^::.+$"), unless(matchesName("anonymous")), hasAncestor(
      functionDecl( hasBody(stmt()) ) ) ), fieldDecl() ), unless(isImplicit()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), anyOf( hasType( qualType( hasUnqualifiedDesugaredType( recordType( hasDeclaration(
      classTemplateSpecializationDecl( hasName("::std::expected") ) ) ) ) ) ), hasType( referenceType( pointee( qualType( hasUnqualifiedDesugaredType(
      recordType( hasDeclaration( classTemplateSpecializationDecl( hasName("::std::expected") ) ) ) ) ) ) ) ) ), unless(matchesName("Expected$"))
      ).bind("value")
    Diagnostic:
      - BindName: value
        Message: named std::expected values must use the Expected suffix
        Level: Warning
  - Name: memly-explicit-contextual-braced-default-argument
    Query: >-
      match parmVarDecl( hasDefaultArgument(), unless(isExpansionInSystemHeader()), hasInitializer( ignoringImplicit( expr( anyOf( cxxConstructExpr(
      isListInitialization(), unless(cxxTemporaryObjectExpr()) ), initListExpr( unless(hasAncestor(cxxFunctionalCastExpr())) ), cxxStdInitializerListExpr(
      unless(hasAncestor(cxxFunctionalCastExpr())) ) ) ).bind("initializer") ) ), isExpansionInFileMatching("[/\\\\]source[/\\\\]") )
    Diagnostic:
      - BindName: initializer
        Message: a braced default argument must explicitly spell its constructed type
        Level: Warning
  - Name: memly-explicit-contextual-braced-expression
    Query: >-
      match stmt( isExpansionInFileMatching("[/\\\\]source[/\\\\]"), anyOf( callExpr( unless(isExpansionInSystemHeader()), forEachArgumentWithParam(
      ignoringImplicit( expr( anyOf( cxxConstructExpr( isListInitialization(), unless(cxxTemporaryObjectExpr()) ), initListExpr(
      unless(hasAncestor(cxxFunctionalCastExpr())) ), cxxStdInitializerListExpr( unless(hasAncestor(cxxFunctionalCastExpr())) ) ) ).bind("initializer") ),
      parmVarDecl() ) ), returnStmt( unless(isExpansionInSystemHeader()), hasReturnValue( ignoringImplicit( expr( anyOf( cxxConstructExpr(
      isListInitialization(), unless(cxxTemporaryObjectExpr()) ), initListExpr( unless(hasAncestor(cxxFunctionalCastExpr())) ), cxxStdInitializerListExpr(
      unless(hasAncestor(cxxFunctionalCastExpr())) ) ) ).bind("initializer") ) ) ), binaryOperator( isAssignmentOperator(), unless(isExpansionInSystemHeader()),
      hasRHS( ignoringImplicit( expr( anyOf( cxxConstructExpr( isListInitialization(), unless(cxxTemporaryObjectExpr()) ), initListExpr(
      unless(hasAncestor(cxxFunctionalCastExpr())) ), cxxStdInitializerListExpr( unless(hasAncestor(cxxFunctionalCastExpr())) ) ) ).bind("initializer") ) ) ) )
      )
    Diagnostic:
      - BindName: initializer
        Message: a contextual braced expression must explicitly spell its constructed type
        Level: Warning
  - Name: memly-explicit-memly-exception-throw
    Query: >-
      match cxxThrowExpr( has(expr()), unless(isExpansionInSystemHeader()), isExpansionInFileMatching("[/\\\\]source[/\\\\]"), unless( has( expr( hasType(
      qualType( hasUnqualifiedDesugaredType( recordType( hasDeclaration( cxxRecordDecl( hasName("::Memly::Exception::MemlyException") ) ) ) ) ) ) ) ) )
      ).bind("throw_expression")
    Diagnostic:
      - BindName: throw_expression
        Message: Memly-originated exceptions must explicitly construct MemlyException
        Level: Warning
  - Name: memly-explicit-rule-of-five
    Query: >-
      match cxxRecordDecl( isDefinition(), unless(isImplicit()), unless(isLambda()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), unless( allOf( has(cxxConstructorDecl(unless(isImplicit()), isCopyConstructor())),
      has(cxxMethodDecl(unless(isImplicit()), isCopyAssignmentOperator())), has(cxxConstructorDecl(unless(isImplicit()), isMoveConstructor())),
      has(cxxMethodDecl(unless(isImplicit()), isMoveAssignmentOperator())), has(cxxDestructorDecl(unless(isImplicit()))) ) ) ).bind("record")
    Diagnostic:
      - BindName: record
        Message: Memly classes and data-carrying structs must explicitly declare the complete Rule of Five
        Level: Warning
  - Name: memly-explicit-return-type-construction
    Query: >-
      match returnStmt( hasReturnValue(expr()), unless(isExpansionInSystemHeader()), isExpansionInFileMatching("[/\\\\]source[/\\\\]"), hasAncestor(
      functionDecl( unless(isTemplateInstantiation()), unless(returns(voidType())), unless(returns(referenceType())), unless(returns(pointerType())), returns(
      qualType( hasCanonicalType( qualType().bind("return_type") ) ) ) ) ), unless( allOf( hasAncestor( functionDecl( hasAncestor(functionTemplateDecl()) ) ),
      hasReturnValue( ignoringImplicit( callExpr( callee( unresolvedLookupExpr( hasAnyDeclaration( namedDecl(hasName("::std::invoke")) ) ) ), hasArgument( 0,
      ignoringImplicit( callExpr( callee( unresolvedLookupExpr( hasAnyDeclaration( namedDecl(hasName("::std::forward")) ) ) ), hasArgument( 0,
      ignoringParenImpCasts( declRefExpr( to( parmVarDecl( hasType(rValueReferenceType()) ) ) ) ) ) ) ) ) ) ) ) ) ), unless( hasReturnValue( ignoringImplicit(
      anyOf( expr( hasType( qualType( hasCanonicalType( qualType( equalsBoundNode("return_type") ) ) ) ), anyOf( cxxTemporaryObjectExpr(isListInitialization()),
      cxxFunctionalCastExpr( hasSourceExpression(initListExpr()) ) ) ), cxxUnresolvedConstructExpr( has(initListExpr()) ) ) ) ) ) ).bind("return")
    Diagnostic:
      - BindName: return
        Message: value returns must explicitly brace-construct their declared return type
        Level: Warning
  - Name: memly-no-class-template-argument-deduction
    Query: >-
      match varDecl( unless(parmVarDecl()), unless(isImplicit()), unless(isInitCapture()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), hasType(deducedTemplateSpecializationType()) ).bind("variable")
    Diagnostic:
      - BindName: variable
        Message: named variable declarations must explicitly specify every class template argument
        Level: Warning
  - Name: memly-no-default-member-initializer
    Query: >-
      match fieldDecl( hasInClassInitializer(anything()), unless(isImplicit()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("field")
    Diagnostic:
      - BindName: field
        Message: default member initializers are disallowed; initialize this member in each constructor initializer list
        Level: Warning
  - Name: memly-no-delegating-constructor
    Query: >-
      match cxxConstructorDecl( unless(isImplicit()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()), isDelegatingConstructor(),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("constructor")
    Diagnostic:
      - BindName: constructor
        Message: delegating constructors are disallowed
        Level: Warning
  - Name: memly-no-deduced-variable-type
    Query: >-
      match varDecl( unless(parmVarDecl()), unless(isImplicit()), unless(isInitCapture()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), anyOf( hasType(autoType()), hasType( referenceType( pointee(autoType()) ) ), hasType( pointerType(
      pointee(autoType()) ) ) ) ).bind("variable")
    Diagnostic:
      - BindName: variable
        Message: deduced variable types require a narrow documented exception
        Level: Warning
  - Name: memly-no-module-interface-function-definition
    Query: >-
      match functionDecl( isDefinition(), unless(isImplicit()), unless(isDeleted()), unless(isDefaulted()), unless(isTemplateInstantiation()),
      unless(isExpansionInSystemHeader()), unless(cxxConstructorDecl()), unless( cxxMethodDecl( ofClass( cxxRecordDecl(isLambda()) ) ) ),
      unless(hasAncestor(functionTemplateDecl())), unless(hasAncestor(classTemplateDecl())), unless(hasAncestor(classTemplatePartialSpecializationDecl())),
      isExpansionInFileMatching("[/\\\\](source|test)[/\\\\].*[.]cppm$") ).bind("function")
    Diagnostic:
      - BindName: function
        Message: ordinary non-template function definitions must remain in .cpp implementation units
        Level: Warning
  - Name: memly-no-magic-integer-in-assertion
    Query: >-
      match integerLiteral( isExpandedFromMacro("assert"), unless(equals(0)), unless(equals(1)), unless(isExpandedFromMacro("__LINE__")),
      unless(isExpansionInSystemHeader()), isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("integer_literal")
    Diagnostic:
      - BindName: integer_literal
        Message: integer literals in assertions must be zero, positive one, or a named constant
        Level: Warning
  - Name: memly-no-magic-integer-in-constant-declaration-type
    Query: >-
      match integerLiteral( allOf( integerLiteral( unless(anyOf(equals(0), equals(1))), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("integer_literal"), hasAncestor( anyOf( varDecl( unless(parmVarDecl()), unless(isImplicit()),
      hasType(isConstQualified()), unless( hasInitializer( hasDescendant( expr(equalsBoundNode("integer_literal")) ) ) ) ), fieldDecl( unless(isImplicit()),
      hasType(isConstQualified()), unless( hasInClassInitializer( hasDescendant( expr(equalsBoundNode("integer_literal")) ) ) ) ) ) ) ) )
    Diagnostic:
      - BindName: integer_literal
        Message: integer literals in const-qualified declaration type spellings must be zero, positive one, or a named constant
        Level: Warning
  - Name: memly-no-negative-magic-integer
    Query: >-
      match unaryOperator( hasOperatorName("-"), hasUnaryOperand( ignoringParenImpCasts( integerLiteral( anyOf( equals(0), equals(1) ) ) ) ), unless(
      hasAncestor( varDecl( hasType(isConstQualified()) ) ) ), unless(hasAncestor(enumConstantDecl())), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("negative_integer_literal")
    Diagnostic:
      - BindName: negative_integer_literal
        Message: negative integer literals must be introduced through a named constant
        Level: Warning
  - Name: memly-no-zero-floating-point-magic-number
    Query: >-
      match floatLiteral( equals(0.0), unless( hasAncestor( varDecl( hasType(isConstQualified()) ) ) ), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("zero_floating_point_literal")
    Diagnostic:
      - BindName: zero_floating_point_literal
        Message: floating-point literals must be introduced through a named constant
        Level: Warning
  - Name: memly-no-named-lambda
    Query: >-
      match varDecl( unless(parmVarDecl()), unless(isImplicit()), unless(isExpansionInSystemHeader()), isExpansionInFileMatching("[/\\\\]source[/\\\\]"), anyOf(
      hasType( qualType( hasUnqualifiedDesugaredType( recordType( hasDeclaration( cxxRecordDecl(isLambda()) ) ) ) ) ), hasType( referenceType( pointee(
      qualType( hasUnqualifiedDesugaredType( recordType( hasDeclaration( cxxRecordDecl(isLambda()) ) ) ) ) ) ) ) ) ).bind("variable")
    Diagnostic:
      - BindName: variable
        Message: named lambda closure variables are disallowed; pass the lambda directly or use a reusable helper
        Level: Warning
  - Name: memly-no-named-declaration-parameter
    Query: >-
      match functionDecl( unless(hasBody(stmt())), unless(isImplicit()), unless(isTemplateInstantiation()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), hasAnyParameter( parmVarDecl( matchesName("^::.+$") ).bind("parameter") ) )
    Diagnostic:
      - BindName: parameter
        Message: parameters must be unnamed in function declarations
        Level: Warning
  - Name: memly-no-namespace-variable
    Query: >-
      match varDecl( unless(isImplicit()), unless(parmVarDecl()), unless(isExpansionInSystemHeader()), hasDeclContext( anyOf( namespaceDecl(),
      translationUnitDecl() ) ), isExpansionInFileMatching("[/\\\\]source[/\\\\]") ).bind("variable")
    Diagnostic:
      - BindName: variable
        Message: global and namespace-scope variables are disallowed
        Level: Warning
  - Name: memly-non-static-data-member-prefix
    Query: >-
      match fieldDecl( unless(isImplicit()), unless( hasAncestor( cxxRecordDecl(isTemplateInstantiation()) ) ), isExpansionInMainFile(),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), matchesName("^::.+$"), unless(matchesName("(^|::)m_[^:]*$")) ).bind("field")
    Diagnostic:
      - BindName: field
        Message: non-static data members must use the m_ prefix
        Level: Warning
  - Name: memly-no-type-declaration-in-implementation-file
    Query: >-
      match decl( anyOf( cxxRecordDecl( unless(isImplicit()), unless(isLambda()), unless(isTemplateInstantiation()) ), enumDecl( unless(isImplicit()) ),
      typedefNameDecl( unless(isImplicit()) ) ), unless(isExpansionInSystemHeader()), isExpansionInFileMatching("[/\\\\](source|test)[/\\\\].*[.]cpp$")
      ).bind("type_declaration")
    Diagnostic:
      - BindName: type_declaration
        Message: type declarations must appear in .cppm module interface units
        Level: Warning
  - Name: memly-no-typedef
    Query: >-
      match typedefDecl( unless(isImplicit()), unless(isExpansionInSystemHeader()), isExpansionInMainFile(),
      isExpansionInFileMatching("[/\\\\](source|test)[/\\\\]") ).bind("typedef")
    Diagnostic:
      - BindName: typedef
        Message: typedef declarations are disallowed; declare an allowed type alias with using
        Level: Warning
  - Name: memly-no-global-prefix
    Query: >-
      match namedDecl( unless(isImplicit()), unless(cxxConstructorDecl()), unless(cxxDestructorDecl()), unless(isExpansionInSystemHeader()),
      isExpansionInFileMatching("[/\\\\]source[/\\\\]"), matchesName("(^|::)g_[^:]*$") ).bind("declaration")
    Diagnostic:
      - BindName: declaration
        Message: the g_ prefix is forbidden for every Memly identifier
        Level: Warning
  - Name: memly-no-database-chain-proxy-field
    Query: >-
      match fieldDecl( unless(isImplicit()), unless(isExpansionInSystemHeader()), isExpansionInFileMatching("[/\\\\]source[/\\\\]"), anyOf( hasType( qualType(
