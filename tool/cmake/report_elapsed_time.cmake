# Returns the current UTC Unix timestamp with microsecond resolution.
function(memly_get_time_microseconds MEMLY_OUTPUT_VARIABLE)
  string(TIMESTAMP MEMLY_CURRENT_TIME_MICROSECONDS "%s%f" UTC)
  set(${MEMLY_OUTPUT_VARIABLE} "${MEMLY_CURRENT_TIME_MICROSECONDS}" PARENT_SCOPE)
endfunction()

# Formats a microsecond duration as seconds with millisecond precision.
function(memly_format_elapsed_time MEMLY_OUTPUT_VARIABLE MEMLY_ELAPSED_MICROSECONDS)
  math(EXPR MEMLY_ELAPSED_MILLISECONDS "(${MEMLY_ELAPSED_MICROSECONDS} + 500) / 1000")
  math(EXPR MEMLY_ELAPSED_SECONDS "${MEMLY_ELAPSED_MILLISECONDS} / 1000")
  math(EXPR MEMLY_ELAPSED_MILLISECOND_REMAINDER "${MEMLY_ELAPSED_MILLISECONDS} % 1000")
  if(MEMLY_ELAPSED_MILLISECOND_REMAINDER LESS 10)
    set(MEMLY_ELAPSED_MILLISECOND_TEXT "00${MEMLY_ELAPSED_MILLISECOND_REMAINDER}")
  elseif(MEMLY_ELAPSED_MILLISECOND_REMAINDER LESS 100)
    set(MEMLY_ELAPSED_MILLISECOND_TEXT "0${MEMLY_ELAPSED_MILLISECOND_REMAINDER}")
  else()
    set(MEMLY_ELAPSED_MILLISECOND_TEXT "${MEMLY_ELAPSED_MILLISECOND_REMAINDER}")
  endif()
  set(${MEMLY_OUTPUT_VARIABLE} "${MEMLY_ELAPSED_SECONDS}.${MEMLY_ELAPSED_MILLISECOND_TEXT} seconds" PARENT_SCOPE)
endfunction()

# Including this file exposes the timing helpers; invoking it directly with cmake -P performs one deferred action.
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED MEMLY_TIMING_ACTION)
    message(FATAL_ERROR "MEMLY_TIMING_ACTION is required")
  endif()
  if(NOT DEFINED MEMLY_TIMING_FILE)
    message(FATAL_ERROR "MEMLY_TIMING_FILE is required")
  endif()

  if(MEMLY_TIMING_ACTION STREQUAL "Start")
    memly_get_time_microseconds(MEMLY_TIMING_START_MICROSECONDS)
    file(WRITE "${MEMLY_TIMING_FILE}" "${MEMLY_TIMING_START_MICROSECONDS}\n")
  elseif(MEMLY_TIMING_ACTION STREQUAL "Report")
    if(NOT EXISTS "${MEMLY_TIMING_FILE}")
      message(FATAL_ERROR "Timing start file does not exist: ${MEMLY_TIMING_FILE}")
    endif()
    file(READ "${MEMLY_TIMING_FILE}" MEMLY_TIMING_START_MICROSECONDS)
    string(STRIP "${MEMLY_TIMING_START_MICROSECONDS}" MEMLY_TIMING_START_MICROSECONDS)
    memly_get_time_microseconds(MEMLY_TIMING_END_MICROSECONDS)
    math(EXPR MEMLY_TIMING_ELAPSED_MICROSECONDS "${MEMLY_TIMING_END_MICROSECONDS} - ${MEMLY_TIMING_START_MICROSECONDS}")
    memly_format_elapsed_time(MEMLY_TIMING_ELAPSED_TIME "${MEMLY_TIMING_ELAPSED_MICROSECONDS}")
    message(STATUS "Elapsed time: ${MEMLY_TIMING_ELAPSED_TIME}")
  else()
    message(FATAL_ERROR "Unsupported MEMLY_TIMING_ACTION: ${MEMLY_TIMING_ACTION}")
  endif()
endif()
