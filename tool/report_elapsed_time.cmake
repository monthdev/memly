if(NOT DEFINED MEMLY_TIMING_ACTION)
  message(FATAL_ERROR "MEMLY_TIMING_ACTION is required")
endif()
if(NOT DEFINED MEMLY_TIMING_FILE)
  message(FATAL_ERROR "MEMLY_TIMING_FILE is required")
endif()

if(MEMLY_TIMING_ACTION STREQUAL "Start")
  string(TIMESTAMP MEMLY_TIMING_START_SECONDS "%s" UTC)
  file(WRITE "${MEMLY_TIMING_FILE}" "${MEMLY_TIMING_START_SECONDS}\n")
elseif(MEMLY_TIMING_ACTION STREQUAL "Report")
  if(NOT DEFINED MEMLY_TIMING_LABEL)
    message(FATAL_ERROR "MEMLY_TIMING_LABEL is required when reporting elapsed time")
  endif()
  if(NOT EXISTS "${MEMLY_TIMING_FILE}")
    message(FATAL_ERROR "Timing start file does not exist: ${MEMLY_TIMING_FILE}")
  endif()
  file(READ "${MEMLY_TIMING_FILE}" MEMLY_TIMING_START_SECONDS)
  string(STRIP "${MEMLY_TIMING_START_SECONDS}" MEMLY_TIMING_START_SECONDS)
  string(TIMESTAMP MEMLY_TIMING_END_SECONDS "%s" UTC)
  math(EXPR MEMLY_TIMING_ELAPSED_SECONDS "${MEMLY_TIMING_END_SECONDS} - ${MEMLY_TIMING_START_SECONDS}")
  if(MEMLY_TIMING_ELAPSED_SECONDS EQUAL 0)
    message(STATUS "${MEMLY_TIMING_LABEL} elapsed time: less than 1 second")
  else()
    message(STATUS "${MEMLY_TIMING_LABEL} elapsed time: ${MEMLY_TIMING_ELAPSED_SECONDS} seconds")
  endif()
else()
  message(FATAL_ERROR "Unsupported MEMLY_TIMING_ACTION: ${MEMLY_TIMING_ACTION}")
endif()
