{
  "name": "Memly",
  "files": [
    {
      "git": 1
    }
  ],
  "lspclient": {
    "servers": {
      "c": {
        "command": [
          "python3",
          "%{Project:NativePath}/tool/lsp/memly_lsp_proxy.py",
          "--project-root",
          "%{Project:NativePath}"
        ],
        "root": "."
      }
    }
  }
}
