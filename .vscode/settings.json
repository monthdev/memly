{
  "cmake.configureOnOpen": true,
  "cmake.configureOnEdit": true,
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.useCMakePresets": "always",
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "files.associations": {
    ".clang-tidy": "yaml",
    ".cmakelintrc": "yaml",
    ".iwyu.imp": "json",
  },
  "clangd.arguments": [
    "--enable-config",
    "--compile-commands-dir=${workspaceFolder}",
  ],
  "qt-qml.qmlls.useNoCMakeCalls": true,
  "lintRunner.respectGitignore": true,
  "lintRunner.tools": {
    "clang-format": {
      "kind": "write",
      "command": "clang-format",
      "cwd": "${workspaceFolder}",
      "args": ["-i", "-style=file", "${file}"],
      "successExitCodes": [0],
      "timeout": 120000,
    },
    "clang-tidy": {
      "kind": "diagnostic",
      "command": "clang-tidy",
      "cwd": "${workspaceFolder}",
      "args": [
        "--experimental-custom-checks",
        "--quiet",
        "--config-file=${workspaceFolder}/.clang-tidy",
        "--header-filter=^$",
        "-p",
        "${workspaceFolder}",
        "${file}",
      ],
      "successExitCodes": [0, 1],
      "timeout": 120000,
      "parser": {
        "pattern": "^.*?:(?<line>\\d+):(?<col>\\d+):\\s+(?<severity>warning|error|fatal|note)(?: error)?:\\s+(?<message>.*?)(?:\\s+\\[(?<code>[^\\]]+)\\])?$",
        "flags": "gm",
        "defaultSeverity": "warning",
      },
    },
    "include-what-you-use": {
      "kind": "diagnostic",
      "command": "python3",
      "cwd": "${workspaceFolder}",
      "args": [
        "${workspaceFolder}/tool/run_include_what_you_use.py",
        "${workspaceFolder}/build/macos-debug/compile_commands.json",
        "${workspaceFolder}/.iwyu.imp",
        "${file}",
      ],
      "successExitCodes": [0, 1],
      "timeout": 120000,
      "parser": {
        "pattern": "^.*?:(?<line>\\d+):(?<col>\\d+):\\s+(?<severity>warning|error|fatal|note)(?: error)?:\\s+(?<message>.*?)$",
        "flags": "gm",
        "defaultSeverity": "warning",
      },
    },
    "cmake-lint": {
      "kind": "diagnostic",
      "command": "cmake-lint",
      "cwd": "${workspaceFolder}",
      "args": [
        "--suppress-decorations",
        "-c",
        "${workspaceFolder}/.cmakelintrc",
        "--",
        "${file}",
      ],
      "successExitCodes": [0, 1],
      "parser": {
        "pattern": "^(?:.*?):(?<line>\\d+)(?:,(?<col>\\d+))?:\\s+\\[(?<code>[A-Z]\\d{4})\\]\\s+(?<message>.*)$",
        "flags": "gm",
        "defaultSeverity": "warning",
      },
    },
    "cmake-format": {
      "kind": "write",
      "command": "cmake-format",
      "cwd": "${workspaceFolder}",
      "args": ["-i", "${file}"],
      "successExitCodes": [0],
      "timeout": 120000,
    },
    "prettier": {
      "kind": "write",
      "command": "prettier",
      "cwd": "${workspaceFolder}",
      "args": ["--write", "--ignore-unknown", "--log-level", "warn", "${file}"],
      "successExitCodes": [0],
      "timeout": 120000,
    },
    "qmlformat": {
      "kind": "write",
      "command": "qmlformat",
      "cwd": "${workspaceFolder}",
      "args": [
        "--settings",
        "${workspaceFolder}/.qmlformat.ini",
        "--inplace",
        "${file}",
      ],
      "successExitCodes": [0],
      "timeout": 120000,
    },
    "sql-formatter": {
      "kind": "write",
      "command": "sql-formatter",
      "cwd": "${workspaceFolder}",
      "args": ["--language", "duckdb", "--fix", "${file}"],
      "successExitCodes": [0],
      "timeout": 120000,
    },
  },
  "lintRunner.targets": [
    {
      "name": "C and C++ Sources",
      "match": {
        "languages": ["c", "cpp", "objective-c", "objective-cpp"],
        "files": [
          "program/**/*.{c,cc,cpp,cxx,m,mm}",
          "test/**/*.{c,cc,cpp,cxx,m,mm}",
        ],
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": ["clang-tidy"],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": ["clang-format"],
      },
      "manual": {
        "strategy": "sequence",
        "tools": ["clang-format", "clang-tidy"],
      },
    },
    {
      "name": "C and C++ Headers",
      "match": {
        "languages": ["c", "cpp", "objective-c", "objective-cpp"],
        "files": ["program/**/*.{h,hh,hpp,hxx}", "test/**/*.{h,hh,hpp,hxx}"],
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": ["include-what-you-use", "clang-tidy"],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": ["clang-format"],
      },
      "manual": {
        "strategy": "sequence",
        "tools": ["clang-format", "include-what-you-use", "clang-tidy"],
      },
    },
    {
      "name": "CMake",
      "match": {
        "languages": ["cmake"],
        "files": ["CMakeLists.txt", "*.cmake", "*.cmake.in"],
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": ["cmake-lint"],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": ["cmake-format"],
      },
      "manual": {
        "strategy": "sequence",
        "tools": ["cmake-format", "cmake-lint"],
      },
    },
    {
      "name": "Prettier",
      "match": {
        "languages": [
          "github-actions-workflow",
          "json",
          "jsonc",
          "markdown",
          "yaml",
        ],
        "files": ["**/*"],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": ["prettier"],
      },
      "manual": {
        "strategy": "sequence",
        "tools": ["prettier"],
      },
    },
    {
      "name": "QML",
      "match": {
        "languages": ["qml"],
        "files": ["program/**/*.qml"],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": ["qmlformat"],
      },
      "manual": {
        "strategy": "sequence",
        "tools": ["qmlformat"],
      },
    },
    {
      "name": "SQL",
      "match": {
        "languages": ["sql"],
        "files": ["program/**/*.sql"],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": ["sql-formatter"],
      },
      "manual": {
        "strategy": "sequence",
        "tools": ["sql-formatter"],
      },
    },
  ],
  "[c]": {
    "editor.formatOnSave": false,
  },
  "[cmake]": {
    "editor.formatOnSave": false,
  },
  "[cpp]": {
    "editor.formatOnSave": false,
  },
  "[github-actions-workflow]": {
    "editor.formatOnSave": false,
  },
  "[json]": {
    "editor.formatOnSave": false,
  },
  "[jsonc]": {
    "editor.formatOnSave": false,
  },
  "[markdown]": {
    "editor.formatOnSave": false,
  },
  "[objective-c]": {
    "editor.formatOnSave": false,
  },
  "[objective-cpp]": {
    "editor.formatOnSave": false,
  },
  "[qml]": {
    "editor.formatOnSave": false,
  },
  "[sql]": {
    "editor.formatOnSave": false,
  },
  "[yaml]": {
    "editor.formatOnSave": false,
  },
}
