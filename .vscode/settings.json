{
  "cmake.configureOnOpen": true,
  "cmake.configureOnEdit": true,
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.useCMakePresets": "always",
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "files.associations": {
    ".iwyu.imp": "json",
  },
  "clangd.arguments": [
    "--enable-config",
    "--compile-commands-dir=${workspaceFolder}",
  ],
  "qt-qml.qmlls.useNoCMakeCalls": true,
  "lintRunner.respectGitignore": true,
  "lintRunner.tools": {
    "clang-tidy": {
      "kind": "diagnostic",
      "command": "clang-tidy",
      "cwd": "${workspaceFolder}",
      "args": [
        "--experimental-custom-checks",
        "--quiet",
        "--config-file=${workspaceFolder}/.clang-tidy",
        "--header-filter=^$",
        "-p",
        "${workspaceFolder}",
        "${file}",
      ],
      "successExitCodes": [
        0,
        1
      ],
      "timeout": 120000,
      "parser": {
        "pattern": "^.*?:(?<line>\\d+):(?<col>\\d+):\\s+(?<severity>warning|error|fatal|note)(?: error)?:\\s+(?<message>.*?)(?:\\s+\\[(?<code>[^\\]]+)\\])?$",
        "flags": "gm",
        "defaultSeverity": "warning",
      },
    },
    "include-what-you-use": {
      "kind": "diagnostic",
      "command": "python3",
      "cwd": "${workspaceFolder}",
      "args": [
        "${workspaceFolder}/tool/run_include_what_you_use.py",
        "${workspaceFolder}/build/macos-debug/compile_commands.json",
        "${workspaceFolder}/.iwyu.imp",
        "${file}",
      ],
      "successExitCodes": [
        0,
        1
      ],
      "timeout": 120000,
      "parser": {
        "pattern": "^.*?:(?<line>\\d+):(?<col>\\d+):\\s+(?<severity>warning|error|fatal|note)(?: error)?:\\s+(?<message>.*?)$",
        "flags": "gm",
        "defaultSeverity": "warning",
      },
    },
    "cmake-lint": {
      "kind": "diagnostic",
      "command": "cmake-lint",
      "cwd": "${workspaceFolder}",
      "args": [
        "--suppress-decorations",
        "-c",
        "${workspaceFolder}/.cmakelintrc",
        "--",
        "${file}",
      ],
      "successExitCodes": [
        0,
        1
      ],
      "parser": {
        "pattern": "^(?:.*?):(?<line>\\d+)(?:,(?<col>\\d+))?:\\s+\\[(?<code>[A-Z]\\d{4})\\]\\s+(?<message>.*)$",
        "flags": "gm",
        "defaultSeverity": "warning",
      },
    },
    "cmake-format": {
      "kind": "write",
      "command": "cmake-format",
      "cwd": "${workspaceFolder}",
      "args": [
        "-i",
        "${file}"
      ],
      "successExitCodes": [
        0
      ],
      "timeout": 120000,
    },
    "qmlformat": {
      "kind": "write",
      "command": "qmlformat",
      "cwd": "${workspaceFolder}",
      "args": [
        "--settings",
        "${workspaceFolder}/.qmlformat.ini",
        "--inplace",
        "${file}",
      ],
      "successExitCodes": [
        0
      ],
      "timeout": 120000,
    },
  },
  "lintRunner.targets": [
    {
      "name": "C and C++ Sources",
      "match": {
        "languages": [
          "c",
          "cpp"
        ],
        "files": [
          "program/**/*.{c,cc,cpp,cxx}",
          "test/**/*.{c,cc,cpp,cxx}"
        ],
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": [
          "clang-tidy"
        ],
      },
      "manual": {
        "strategy": "sequence",
        "tools": [
          "clang-tidy"
        ],
      },
    },
    {
      "name": "C and C++ Headers",
      "match": {
        "languages": [
          "c",
          "cpp"
        ],
        "files": [
          "program/**/*.{h,hh,hpp,hxx}",
          "test/**/*.{h,hh,hpp,hxx}"
        ],
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": [
          "include-what-you-use",
          "clang-tidy"
        ],
      },
      "manual": {
        "strategy": "sequence",
        "tools": [
          "include-what-you-use",
          "clang-tidy"
        ],
      },
    },
    {
      "name": "CMake",
      "match": {
        "languages": [
          "cmake"
        ],
        "files": [
          "CMakeLists.txt",
          "*.cmake",
          "*.cmake.in"
        ],
      },
      "onOpen": {
        "strategy": "sequence",
        "tools": [
          "cmake-lint"
        ],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": [
          "cmake-format"
        ],
      },
      "manual": {
        "strategy": "sequence",
        "tools": [
          "cmake-format",
          "cmake-lint"
        ],
      },
    },
    {
      "name": "QML",
      "match": {
        "languages": [
          "qml"
        ],
        "files": [
          "program/**/*.qml"
        ],
      },
      "onSave": {
        "strategy": "sequence",
        "tools": [
          "qmlformat"
        ],
      },
      "manual": {
        "strategy": "sequence",
        "tools": [
          "qmlformat"
        ],
      },
    },
  ],
  "[cmake]": {
    "editor.formatOnSave": false,
  },
  "[qml]": {
    "editor.defaultFormatter": "theqtcompany.qt-qml",
    "editor.formatOnSave": false,
  },
}
